@model LoginForm
@inject IWebHostEnvironment HostEnvironment
@{
    ViewData["Title"] = "Sign in";
}
<div class="auth-layout">
    <section class="auth-story" aria-label="About AcxiomCRM">
        <a class="brand" href="/"><span class="brand-mark">a</span><span>acxiom<span class="brand-crm">CRM</span></span></a>
        <div>
            <div class="eyebrow">Sales workspace</div>
            <h1>Every customer.<br />Every follow-up.<br />One clear view.</h1>
            <p>Leads, deals and conversations for your whole sales team, with a dashboard built for your role.</p>
        </div>
        <div class="story-roles">
            <div class="story-role"><span>AD</span><div><strong>Administrator</strong><small>Users, roles, security and audit</small></div></div>
            <div class="story-role"><span>MG</span><div><strong>Sales Manager</strong><small>Team performance and pipeline</small></div></div>
            <div class="story-role"><span>SE</span><div><strong>Sales Executive</strong><small>My leads, deals and today's agenda</small></div></div>
        </div>
    </section>

    <section class="login-card">
        <div class="eyebrow">Welcome back</div>
        <h2 style="font-size:24px;margin:6px 0 4px">Sign in to your workspace</h2>
        <p class="muted">Your dashboard opens based on your role.</p>
        <form method="post" action="/Account/Login" novalidate>
            @Html.AntiForgeryToken()
            @if (ViewBag.ReturnUrl is string returnUrl)
            {
                <input type="hidden" name="returnUrl" value="@returnUrl" />
            }
            <div asp-validation-summary="ModelOnly" class="validation-panel" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" placeholder="you@company.in" />
                <span asp-validation-for="Email"></span>
            </div>
            <div class="mb-4">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password"></span>
            </div>
            <button class="btn btn-primary w-100" type="submit">Sign in</button>
        </form>
        <p class="auth-switch">New to the team? <a href="/Account/Register">Create an account</a></p>
        @if (HostEnvironment.IsDevelopment())
        {
            <div class="demo-accounts">
                <strong>Local demo accounts</strong> (development only): admin@acxiom.test, manager@acxiom.test, sales@acxiom.test, sales2@acxiom.test. The password is in README.md.
            </div>
        }
    </section>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
