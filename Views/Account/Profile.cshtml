@model ProfilePageViewModel
@{
    ViewData["Title"] = "My profile";
}
<div class="page-heading">
    <div class="profile-header">
        <div class="avatar" aria-hidden="true">@DisplayHelpers.Initials(Model.SavedName)</div>
        <div>
            <div class="eyebrow">Account</div>
            <h1>My profile</h1>
            <p class="muted">@Model.Email · <span class="role-chip">@Model.RoleTitle</span></p>
        </div>
    </div>
</div>

<div class="dashboard-grid equal">
    <section class="panel" aria-labelledby="detailsHeading">
        <div class="panel-heading"><div><h2 id="detailsHeading">Personal details</h2><p>Your name appears on records assigned to you.</p></div></div>
        <form method="post" action="/Account/UpdateProfile" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="validation-panel" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Details.Name" class="form-label"></label>
                <input asp-for="Details.Name" class="form-control" maxlength="80" autocomplete="name" />
                <span asp-validation-for="Details.Name"></span>
            </div>
            <dl class="detail-list" style="grid-template-columns:1fr 1fr">
                <div><dt>Email</dt><dd>@Model.Email</dd></div>
                <div><dt>Role</dt><dd>@Model.RoleTitle</dd></div>
                <div><dt>Member since</dt><dd>@Model.MemberSince.ToString("dd MMM yyyy")</dd></div>
                <div><dt>Previous sign-in</dt><dd>@(Model.LastLogin.HasValue ? Model.LastLogin.Value.ToString("dd MMM yyyy, HH:mm") + " UTC" : "First sign-in")</dd></div>
            </dl>
            <p class="form-text" style="margin-top:10px">Email and role are managed by an administrator.</p>
            <div class="form-actions"><button class="btn btn-primary" type="submit">Save name</button></div>
        </form>
    </section>

    <section class="panel" aria-labelledby="passwordHeading">
        <div class="panel-heading"><div><h2 id="passwordHeading">Change password</h2><p>Changing it signs you out on every other device.</p></div></div>
        <form method="post" action="/Account/ChangePassword" novalidate>
            @Html.AntiForgeryToken()
            <div class="mb-3">
                <label asp-for="Password.CurrentPassword" class="form-label"></label>
                <input asp-for="Password.CurrentPassword" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password.CurrentPassword"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password.NewPassword" class="form-label"></label>
                <input asp-for="Password.NewPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password.NewPassword"></span>
                <div class="form-text">At least 8 characters with uppercase, lowercase, a number and a symbol.</div>
            </div>
            <div class="mb-3">
                <label asp-for="Password.ConfirmPassword" class="form-label"></label>
                <input asp-for="Password.ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password.ConfirmPassword"></span>
            </div>
            <div class="form-actions"><button class="btn btn-primary" type="submit">Change password</button></div>
        </form>
    </section>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
