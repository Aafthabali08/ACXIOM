@model RegisterForm
@{
    ViewData["Title"] = "Create account";
}
<section class="register-card">
    <a class="brand" href="/" style="padding:0;margin-bottom:22px"><span class="brand-mark">a</span><span>acxiom<span class="brand-crm">CRM</span></span></a>
    <div class="eyebrow">Join your team</div>
    <h1 style="font-size:26px">Create your account</h1>
    <p class="muted">New accounts start as <strong>Sales Executive</strong>. An administrator can change your role later.</p>
    <form method="post" action="/Account/Register" novalidate>
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="validation-panel" role="alert"></div>
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control" autocomplete="name" maxlength="80" />
            <span asp-validation-for="Name"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label"></label>
            <input asp-for="Email" class="form-control" type="email" autocomplete="username" maxlength="160" />
            <span asp-validation-for="Email"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label"></label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Password"></span>
            <div class="form-text">At least 8 characters, including uppercase, lowercase, a number and a symbol.</div>
        </div>
        <div class="mb-4">
            <label asp-for="Confirm" class="form-label"></label>
            <input asp-for="Confirm" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Confirm"></span>
        </div>
        <button class="btn btn-primary w-100" type="submit">Create account</button>
    </form>
    <p class="auth-switch">Already registered? <a href="/Account/Login">Sign in</a></p>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
