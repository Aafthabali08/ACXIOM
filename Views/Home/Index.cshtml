@model DashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = Model.RoleTitle + " dashboard";
    var filter = Model.Filter;
    var periodQuery = $"from={filter.From:yyyy-MM-dd}&to={filter.To:yyyy-MM-dd}";
    var scopeWord = Model.ScopeWord;
    var leadStatuses = CrmCatalog.StatusesFor("leads");
    var subtitle = Model.IsAdmin ? "Keep the workspace secure and see how the whole business is doing."
        : Model.IsManager ? "See how your team is performing and where they need your support."
        : "Your customers, deals and next conversations, all in one place.";
}

<div class="welcome-row">
    <div>
        <div class="eyebrow">@Model.RoleTitle workspace · @filter.PeriodLabel</div>
        <h1>@DisplayHelpers.Greeting(), @DisplayHelpers.FirstName(Model.UserName)</h1>
        <p class="muted">@subtitle</p>
    </div>
    <div class="page-actions">
        @if (Model.IsAdmin)
        {
            <a class="btn btn-light" href="/Reports?report=audit">Audit log</a>
            <a class="btn btn-primary" href="/Users/Edit">+ Add user</a>
        }
        else if (Model.IsManager)
        {
            <a class="btn btn-light" href="/Reports?report=pipeline">Pipeline report</a>
            <a class="btn btn-primary" href="/Team">Team performance</a>
        }
        else
        {
            <a class="btn btn-light" href="/crm/followups/create">+ Schedule follow-up</a>
            <a class="btn btn-primary" href="/crm/leads/create">+ Add lead</a>
        }
    </div>
</div>

<div asp-validation-summary="All" class="validation-panel" role="alert"></div>
<partial name="_PeriodFilter" model="filter" />
<p class="scope-note">"All time" shows every record you are allowed to see. The other periods count records created in that period. Follow-up counts always show work that is still pending.</p>

@* ================= ADMIN: System access ================= *@
@if (Model.IsAdmin)
{
    <div class="section-title"><h2>System access</h2><a href="/Users">Manage users</a></div>
    <section class="metric-grid" aria-label="System access">
        <a class="metric" href="/Users">
            <div class="metric-label">Total users <svg aria-hidden="true"><use href="#i-users" /></svg></div>
            <strong>@Model.TotalUsers</strong><small>@Model.ActiveUsers active · @(Model.TotalUsers - Model.ActiveUsers) inactive</small>
        </a>
        <a class="metric" href="/Users?state=active">
            <div class="metric-label">Active accounts <svg aria-hidden="true"><use href="#i-shield" /></svg></div>
            <strong>@Model.ActiveUsers</strong><small>Can sign in right now</small>
        </a>
        <a class="metric @(Model.LockedUsers > 0 ? "alert-metric" : "")" href="/Users?state=locked">
            <div class="metric-label">Locked accounts <svg aria-hidden="true"><use href="#i-lock" /></svg></div>
            <strong>@Model.LockedUsers</strong><small>After repeated wrong passwords</small>
        </a>
        <a class="metric @(Model.FailedLoginsLast24Hours > 0 ? "alert-metric" : "")" href="/Reports?report=audit&result=Failed">
            <div class="metric-label">Failed sign-ins · 24h <svg aria-hidden="true"><use href="#i-alert" /></svg></div>
            <strong>@Model.FailedLoginsLast24Hours</strong><small>Review in the audit log</small>
        </a>
    </section>
}

@* ================= Mandatory KPI cards (assignment PDF 17.11), scoped to the user ================= *@
<div class="section-title">
    <h2>@(Model.IsSalesExecutive ? "My numbers" : Model.IsManager ? "Team snapshot" : "Business snapshot")</h2>
    <span class="faint">@filter.PeriodLabel</span>
</div>
<section class="metric-grid" aria-label="Key numbers">
    <a class="metric" href="/crm/customers?@periodQuery">
        <div class="metric-label">Total customers <svg aria-hidden="true"><use href="#i-building" /></svg></div>
        <strong>@Model.Customers.Count</strong><small>@scopeWord customers in scope</small>
    </a>
    <a class="metric" href="/crm/leads?@periodQuery">
        <div class="metric-label">Total leads <svg aria-hidden="true"><use href="#i-target" /></svg></div>
        <strong>@Model.Leads.Count</strong><small>@Model.Leads.Count(row => row.Status == "Converted") converted to customers</small>
    </a>
    <a class="metric" href="/crm/leads?@periodQuery">
        <div class="metric-label">Open leads <svg aria-hidden="true"><use href="#i-target" /></svg></div>
        <strong>@Model.OpenLeadCount</strong><small>Not converted, lost or unqualified</small>
    </a>
    <a class="metric" href="/crm/opportunities?@periodQuery">
        <div class="metric-label">Total opportunities <svg aria-hidden="true"><use href="#i-chart" /></svg></div>
        <strong>@Model.Opportunities.Count</strong><small>Win rate @Model.WinRate</small>
    </a>
    <a class="metric" href="/crm/opportunities?status=Open&@periodQuery">
        <div class="metric-label">Open opportunities <svg aria-hidden="true"><use href="#i-chart" /></svg></div>
        <strong>@Model.OpenOpportunities.Count</strong><small>Still in the pipeline</small>
    </a>
    <a class="metric" href="/crm/opportunities?status=Won&@periodQuery">
        <div class="metric-label">Won opportunities <svg aria-hidden="true"><use href="#i-check" /></svg></div>
        <strong>@Model.WonCount</strong><small>@DisplayHelpers.Rupees(Model.WonValue) won</small>
    </a>
    <a class="metric" href="/crm/opportunities?status=Lost&@periodQuery">
        <div class="metric-label">Lost opportunities <svg aria-hidden="true"><use href="#i-alert" /></svg></div>
        <strong>@Model.LostCount</strong><small>Closed without a sale</small>
    </a>
    <a class="metric inverted" href="/Reports?report=pipeline&@periodQuery">
        <div class="metric-label">Total pipeline value <svg aria-hidden="true"><use href="#i-rupee" /></svg></div>
        <strong>@DisplayHelpers.Rupees(Model.OpenPipelineValue)</strong><small>@DisplayHelpers.Rupees(Model.WeightedPipelineValue) weighted (amount × probability)</small>
    </a>
</section>
<section class="mini-stats" style="margin-top:14px;grid-template-columns:repeat(3,minmax(0,1fr))" aria-label="Follow-up work">
    <a class="mini-stat" href="/crm/followups?status=Planned&sort=date" style="text-decoration:none"><small>Pending follow-ups</small><strong>@Model.PendingFollowUps.Count</strong></a>
    <a class="mini-stat" href="/crm/followups?status=Planned&sort=date" style="text-decoration:none"><small>Due today</small><strong>@Model.TodayFollowUps.Count</strong></a>
    <a class="mini-stat" href="/crm/followups?status=Overdue" style="text-decoration:none"><small>Overdue</small><strong class="@(Model.OverdueFollowUps.Count > 0 ? "text-danger" : "")">@Model.OverdueFollowUps.Count</strong></a>
</section>

@* ================= SALES EXECUTIVE ================= *@
@if (Model.IsSalesExecutive)
{
    <div class="dashboard-grid">
        <section class="panel" aria-labelledby="agendaHeading">
            <div class="panel-heading">
                <div><h2 id="agendaHeading">Today's agenda</h2><p>@Model.OverdueFollowUps.Count overdue · @Model.TodayFollowUps.Count due today · @Model.PendingFollowUps.Count pending in total</p></div>
                <a href="/crm/followups?status=Planned&sort=date">All follow-ups</a>
            </div>
            @if (Model.PendingFollowUps.Count == 0)
            {
                <div class="empty-state">Nothing pending. <a href="/crm/followups/create">Schedule a follow-up</a></div>
            }
            <div class="task-list">
                @foreach (var followUp in Model.PendingFollowUps.Take(6))
                {
                    <partial name="_TaskRow" model="followUp" />
                }
            </div>
        </section>
        <section class="panel" aria-labelledby="leadHeading">
            <div class="panel-heading"><div><h2 id="leadHeading">My lead status</h2><p>From first contact to conversion</p></div><a href="/crm/leads?@periodQuery">My leads</a></div>
            <div class="chart-box short"><canvas id="leadChart" role="img" aria-label="My leads by status"></canvas></div>
        </section>
    </div>

    <div class="dashboard-grid">
        <section class="panel" aria-labelledby="pipelineHeading">
            <div class="panel-heading"><div><h2 id="pipelineHeading">My pipeline by stage</h2><p>Deal value in each sales stage</p></div><a href="/crm/opportunities?@periodQuery">My opportunities</a></div>
            <div class="chart-box"><canvas id="pipelineChart" role="img" aria-label="My opportunity value by stage"></canvas></div>
        </section>
        <section class="panel" aria-labelledby="closingHeading">
            <div class="panel-heading"><div><h2 id="closingHeading">Closing in 30 days</h2><p>Open deals to push over the line</p></div></div>
            @if (Model.DealsClosingSoon.Count == 0)
            {
                <div class="empty-state">No open deals closing in the next 30 days.</div>
            }
            <div class="task-list">
                @foreach (var deal in Model.DealsClosingSoon)
                {
                    <div class="task-row">
                        <span class="task-icon" aria-hidden="true"><svg><use href="#i-rupee" /></svg></span>
                        <div class="task-text"><a href="/crm/opportunities/@deal.Id">@deal.Name</a><small>@deal.RelatedTo · @deal.Stage · @deal.Probability%</small></div>
                        <div class="task-side"><strong>@DisplayHelpers.Rupees(deal.Amount)</strong></div>
                    </div>
                }
            </div>
        </section>
    </div>

    <div class="dashboard-grid equal">
        <section class="panel" aria-labelledby="salesHeading">
            <div class="panel-heading"><div><h2 id="salesHeading">My monthly sales</h2><p>Won deal value · last six months</p></div></div>
            <div class="chart-box short"><canvas id="salesChart" role="img" aria-label="My won sales per month"></canvas></div>
        </section>
        <section class="panel" aria-labelledby="activityHeading">
            <div class="panel-heading"><div><h2 id="activityHeading">My recent activities</h2><p>Calls, meetings, emails and tasks</p></div><a href="/crm/activities/create">+ Log activity</a></div>
            @if (Model.RecentActivities.Count == 0)
            {
                <div class="empty-state">No activities logged yet.</div>
            }
            <div class="task-list">
                @foreach (var activity in Model.RecentActivities)
                {
                    <partial name="_TaskRow" model="activity" />
                }
            </div>
        </section>
    </div>
}

@* ================= MANAGER ================= *@
@if (Model.IsManager)
{
    <div class="dashboard-grid">
        <section class="panel" aria-labelledby="teamChartHeading">
            <div class="panel-heading"><div><h2 id="teamChartHeading">Team pipeline vs won</h2><p>Open pipeline and won value per sales executive</p></div><a href="/Team?period=@filter.Period&from=@filter.From?.ToString("yyyy-MM-dd")&to=@filter.To?.ToString("yyyy-MM-dd")">Full team view</a></div>
            <div class="chart-box"><canvas id="teamChart" role="img" aria-label="Open pipeline and won value per team member"></canvas></div>
        </section>
        <section class="panel" aria-labelledby="leadHeading">
            <div class="panel-heading"><div><h2 id="leadHeading">Team lead funnel</h2><p>Lead count by status</p></div><a href="/crm/leads?@periodQuery">Leads</a></div>
            <div class="chart-box"><canvas id="leadChart" role="img" aria-label="Team leads by status"></canvas></div>
        </section>
    </div>
}

@* ================= MANAGER + ADMIN: team table ================= *@
@if (Model.IsManager || Model.IsAdmin)
{
    <section class="panel" style="margin-top:16px" aria-labelledby="teamHeading">
        <div class="panel-heading">
            <div><h2 id="teamHeading">Team performance</h2><p>Selected period · overdue follow-ups are current</p></div>
            <a href="/Team?period=@filter.Period&from=@filter.From?.ToString("yyyy-MM-dd")&to=@filter.To?.ToString("yyyy-MM-dd")">Open team performance</a>
        </div>
        <div class="table-wrap">
            <table class="table crm-table">
                <thead><tr><th>Sales executive</th><th class="number-cell">Leads</th><th class="number-cell">Open deals</th><th class="number-cell">Open pipeline</th><th class="number-cell">Won</th><th class="number-cell">Win rate</th><th class="number-cell">Overdue</th></tr></thead>
                <tbody>
                    @foreach (var member in Model.TeamPerformance)
                    {
                        <tr>
                            <td><a class="record-name" href="/crm/leads?owner=@member.UserId&@periodQuery">@member.Name</a></td>
                            <td class="number-cell">@member.LeadCount</td>
                            <td class="number-cell">@member.OpenDeals</td>
                            <td class="number-cell">@DisplayHelpers.Rupees(member.OpenPipeline)</td>
                            <td class="number-cell">@member.WonDeals</td>
                            <td class="number-cell">@member.WinRate</td>
                            <td class="number-cell">@if (member.OverdueFollowUps > 0) {<a href="/crm/followups?owner=@member.UserId&status=Overdue" class="text-danger">@member.OverdueFollowUps</a>} else {<span>0</span>}</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.TeamPerformance.Count == 0)
        {
            <div class="empty-state">No sales executives or assigned records yet.</div>
        }
    </section>
}

@if (Model.IsManager)
{
    <div class="dashboard-grid">
        <section class="panel" aria-labelledby="pipelineHeading">
            <div class="panel-heading"><div><h2 id="pipelineHeading">Team pipeline by stage</h2><p>Deal value in each sales stage</p></div><a href="/Reports?report=pipeline&@periodQuery">Pipeline report</a></div>
            <div class="chart-box"><canvas id="pipelineChart" role="img" aria-label="Team opportunity value by stage"></canvas></div>
        </section>
        <section class="panel" aria-labelledby="salesHeading">
            <div class="panel-heading"><div><h2 id="salesHeading">Team monthly sales</h2><p>Won deal value · last six months</p></div></div>
            <div class="chart-box"><canvas id="salesChart" role="img" aria-label="Team won sales per month"></canvas></div>
        </section>
    </div>
    <div class="dashboard-grid equal">
        <section class="panel" aria-labelledby="attentionHeading">
            <div class="panel-heading"><div><h2 id="attentionHeading">Needs attention</h2><p>@Model.OverdueFollowUps.Count overdue follow-ups across the team</p></div><a href="/crm/followups?status=Overdue">All overdue</a></div>
            @if (Model.OverdueFollowUps.Count == 0)
            {
                <div class="empty-state">No overdue follow-ups. The team is on track.</div>
            }
            <div class="task-list">
                @foreach (var followUp in Model.OverdueFollowUps.Take(6))
                {
                    <partial name="_TaskRow" model="followUp" />
                }
            </div>
        </section>
        <section class="panel" aria-labelledby="closingHeading">
            <div class="panel-heading"><div><h2 id="closingHeading">Deals closing in 30 days</h2><p>Open deals with a near close date</p></div><a href="/crm/opportunities?status=Open&sort=date">All open deals</a></div>
            @if (Model.DealsClosingSoon.Count == 0)
            {
                <div class="empty-state">No open deals closing in the next 30 days.</div>
            }
            <div class="task-list">
                @foreach (var deal in Model.DealsClosingSoon)
                {
                    <div class="task-row">
                        <span class="task-icon" aria-hidden="true"><svg><use href="#i-rupee" /></svg></span>
                        <div class="task-text"><a href="/crm/opportunities/@deal.Id">@deal.Name</a><small>@deal.Owner · @deal.Stage · closes @deal.CloseDate?.ToString("dd MMM")</small></div>
                        <div class="task-side"><strong>@DisplayHelpers.Rupees(deal.Amount)</strong></div>
                    </div>
                }
            </div>
        </section>
    </div>
}

@* ================= ADMIN ================= *@
@if (Model.IsAdmin)
{
    <div class="dashboard-grid">
        <section class="panel" aria-labelledby="pipelineHeading">
            <div class="panel-heading"><div><h2 id="pipelineHeading">Company pipeline by stage</h2><p>Deal value in each sales stage</p></div><a href="/Reports?report=pipeline&@periodQuery">Pipeline report</a></div>
            <div class="chart-box"><canvas id="pipelineChart" role="img" aria-label="Company opportunity value by stage"></canvas></div>
        </section>
        <section class="panel" aria-labelledby="rolesHeading">
            <div class="panel-heading"><div><h2 id="rolesHeading">Users by role</h2><p>Each account holds exactly one role</p></div><a href="/Users/Roles">Permissions</a></div>
            <div class="role-bars">
                @foreach (var roleName in CrmCatalog.Roles)
                {
                    var roleCount = Model.UsersPerRole.GetValueOrDefault(roleName);
                    var fillPercent = Model.TotalUsers == 0 ? 0 : 100 * roleCount / Model.TotalUsers;
                    <a href="/Users?role=@roleName" style="text-decoration:none">
                        <div class="role-bar-label"><span>@CrmCatalog.RoleTitle(roleName)</span><strong>@roleCount</strong></div>
                        <div class="role-bar-track"><div class="role-bar-fill" style="width:@fillPercent%"></div></div>
                    </a>
                }
            </div>
            <h3 style="margin:22px 0 6px">Recently added</h3>
            <div class="event-list">
                @foreach (var recentUser in Model.RecentUsers)
                {
                    <div class="event-row">
                        <span class="event-dot @(recentUser.Active ? "" : "failed")"></span>
                        <div><strong>@recentUser.Name</strong> <span>· @recentUser.Role</span></div>
                        <small>@recentUser.CreatedAt.ToString("dd MMM yyyy")</small>
                    </div>
                }
            </div>
        </section>
    </div>
    <div class="dashboard-grid">
        <section class="panel" aria-labelledby="auditHeading">
            <div class="panel-heading"><div><h2 id="auditHeading">Latest security &amp; business events</h2><p>Everything is recorded in the append-only audit log</p></div><a href="/Reports?report=audit">Open audit log</a></div>
            @if (Model.RecentAuditEvents.Count == 0)
            {
                <div class="empty-state">No audit events yet.</div>
            }
            <div class="event-list">
                @foreach (var auditEvent in Model.RecentAuditEvents)
                {
                    <div class="event-row">
                        <span class="event-dot @(auditEvent.Result == "Failed" ? "failed" : "")"></span>
                        <div><strong>@auditEvent.Action</strong> <span>· @auditEvent.Entity · @auditEvent.UserName</span></div>
                        <small>@auditEvent.CreatedAt.ToString("dd MMM, HH:mm") UTC</small>
                    </div>
                }
            </div>
        </section>
        <section class="panel" aria-labelledby="salesHeading">
            <div class="panel-heading"><div><h2 id="salesHeading">Company monthly sales</h2><p>Won deal value · last six months</p></div></div>
            <div class="chart-box"><canvas id="salesChart" role="img" aria-label="Company won sales per month"></canvas></div>
        </section>
    </div>
}

<div id="chartData" hidden
     data-stages="@JsonSerializer.Serialize(CrmCatalog.Stages)"
     data-pipeline="@JsonSerializer.Serialize(CrmCatalog.Stages.Select(stageName => Model.Opportunities.Where(row => row.Stage == stageName).Sum(row => row.Amount)))"
     data-lead-labels="@JsonSerializer.Serialize(leadStatuses)"
     data-lead-counts="@JsonSerializer.Serialize(leadStatuses.Select(statusName => Model.Leads.Count(row => row.Status == statusName)))"
     data-months="@JsonSerializer.Serialize(Model.MonthLabels)"
     data-sales="@JsonSerializer.Serialize(Model.MonthlyWonSales)"
     data-team-names="@JsonSerializer.Serialize(Model.TeamPerformance.Select(member => member.Name))"
     data-team-pipeline="@JsonSerializer.Serialize(Model.TeamPerformance.Select(member => member.OpenPipeline))"
     data-team-won="@JsonSerializer.Serialize(Model.TeamPerformance.Select(member => member.WonValue))"></div>

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
