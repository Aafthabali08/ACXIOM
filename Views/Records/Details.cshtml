@model RecordDto
@{
    var moduleName = Model.Module;
    ViewData["Title"] = Model.Name;
    List<AuditLog> historyEntries = ViewBag.History;
    List<RecordDto> relatedFollowUps = ViewBag.FollowUps;
    List<RecordDto> relatedActivities = ViewBag.Activities;
    List<RecordDto> relatedOpportunities = ViewBag.Opportunities;
    var isConvertedLead = moduleName == "leads" && Model.Status == "Converted";
    var canMarkDone = (moduleName == "followups" && Model.Status == "Planned") || (moduleName == "activities" && Model.Status == "Pending");
    var canHaveFollowUps = moduleName is "customers" or "leads" or "opportunities";
    var linkParameter = moduleName switch { "customers" => "customerId", "leads" => "leadId", _ => "opportunityId" };

    // Only the fields that make sense for this module, and only when they have a value.
    var detailFields = new List<(string Label, string? Value)>
    {
        ("Code", Model.Code),
        ("Status", Model.IsOverdue ? "Planned (overdue)" : Model.Status),
        ("Assigned to", Model.Owner),
        ("Company", Model.Company),
        ("Email", Model.Email),
        ("Mobile", Model.Phone),
        ("Address", Model.Address),
        ("City", Model.City),
        ("State", Model.State),
        ("Source", Model.Source),
        ("Priority", Model.Priority),
        ("Expected value", moduleName == "leads" ? DisplayHelpers.Rupees(Model.ExpectedValue) : null),
        (moduleName == "leads" ? "Converted to customer" : "Related to", Model.RelatedTo),
        ("Stage", Model.Stage),
        ("Amount", moduleName == "opportunities" ? DisplayHelpers.Rupees(Model.Amount) : null),
        ("Probability", moduleName == "opportunities" ? Model.Probability + "%" : null),
        ("Weighted value", moduleName == "opportunities" ? DisplayHelpers.Rupees(Model.WeightedAmount) : null),
        ("Expected close date", Model.CloseDate?.ToString("dd MMM yyyy")),
        ("Won / lost on", Model.OutcomeDate?.ToString("dd MMM yyyy")),
        ("Type", Model.Type),
        ("Date", Model.DueDate?.ToString("dd MMM yyyy")),
        ("Created", Model.CreatedAt.ToString("dd MMM yyyy, HH:mm") + " UTC"),
        ("Last updated", Model.UpdatedAt.ToString("dd MMM yyyy, HH:mm") + " UTC")
    };
}
<div class="page-heading">
    <div>
        <a class="back-link" href="/crm/@moduleName">@CrmCatalog.ModuleTitle(moduleName)</a>
        <h1>@Model.Name</h1>
        <p class="muted"><span class="status-badge @(Model.IsOverdue ? "negative" : DisplayHelpers.StatusBadgeClass(Model.Status))">@(Model.IsOverdue ? "Overdue" : Model.Status)</span> @(Model.Company ?? Model.RelatedTo)</p>
    </div>
    <div class="page-actions">
        @if (canMarkDone)
        {
            <form action="/crm/@moduleName/@Model.Id/complete" method="post">
                @Html.AntiForgeryToken()
                <button class="btn btn-light" type="submit">Mark done</button>
            </form>
        }
        @if (isConvertedLead)
        {
            @if (Model.CustomerId.HasValue)
            {
                <a class="btn btn-primary" href="/crm/customers/@Model.CustomerId">Open customer</a>
            }
        }
        else
        {
            <a class="btn btn-primary" href="/crm/@moduleName/@Model.Id/edit">Edit</a>
        }
        <form action="/crm/@moduleName/@Model.Id/delete" method="post" data-confirm="Delete this record? It will disappear from active lists but stays in the audit history.">
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-danger" type="submit">Delete</button>
        </form>
    </div>
</div>

@if (moduleName == "leads" && Model.Status == "Qualified")
{
    <div class="conversion-callout">
        <div>
            <strong>Ready for the next step</strong>
            <p>Convert this qualified lead into a customer@(Model.ExpectedValue > 0 ? $" and an opportunity worth {DisplayHelpers.Rupees(Model.ExpectedValue)}" : "").</p>
        </div>
        <form action="/crm/leads/@Model.Id/convert" method="post" data-confirm="Convert this qualified lead to a customer?">
            @Html.AntiForgeryToken()
            <button class="btn btn-primary" type="submit">Convert lead</button>
        </form>
    </div>
}

<div class="details-layout">
    <div>
        <section class="panel">
            <div class="panel-heading"><h2>Details</h2></div>
            <dl class="detail-list">
                @foreach (var (fieldLabel, fieldValue) in detailFields.Where(field => !string.IsNullOrWhiteSpace(field.Value)))
                {
                    <div><dt>@fieldLabel</dt><dd>@fieldValue</dd></div>
                }
            </dl>
            @if (!string.IsNullOrWhiteSpace(Model.Notes))
            {
                <div class="notes-box">@Model.Notes</div>
            }
        </section>

        @if (relatedOpportunities.Count > 0)
        {
            <section class="panel">
                <div class="panel-heading"><div><h2>Opportunities</h2><p>@relatedOpportunities.Count linked</p></div></div>
                <div class="task-list">
                    @foreach (var deal in relatedOpportunities)
                    {
                        <div class="task-row">
                            <span class="task-icon" aria-hidden="true"><svg><use href="#i-rupee" /></svg></span>
                            <div class="task-text"><a href="/crm/opportunities/@deal.Id">@deal.Name</a><small>@deal.Stage · @deal.Probability% · @deal.Owner</small></div>
                            <div class="task-side"><strong>@DisplayHelpers.Rupees(deal.Amount)</strong></div>
                        </div>
                    }
                </div>
            </section>
        }

        @if (canHaveFollowUps)
        {
            <section class="panel">
                <div class="panel-heading">
                    <div><h2>Follow-ups</h2><p>@relatedFollowUps.Count(row => row.Status == "Planned") planned · @relatedFollowUps.Count total</p></div>
                    <a href="/crm/followups/create?@linkParameter=@Model.Id">+ Schedule follow-up</a>
                </div>
                @if (relatedFollowUps.Count == 0)
                {
                    <div class="empty-state">No follow-ups yet.</div>
                }
                <div class="task-list">
                    @foreach (var followUp in relatedFollowUps)
                    {
                        <partial name="_TaskRow" model="followUp" />
                    }
                </div>
            </section>
        }

        @if (moduleName is "customers" or "leads")
        {
            <section class="panel">
                <div class="panel-heading">
                    <div><h2>Activities</h2><p>Calls, meetings, emails and tasks</p></div>
                    <a href="/crm/activities/create?@linkParameter=@Model.Id">+ Log activity</a>
                </div>
                @if (relatedActivities.Count == 0)
                {
                    <div class="empty-state">No activities logged yet.</div>
                }
                <div class="task-list">
                    @foreach (var activity in relatedActivities)
                    {
                        <partial name="_TaskRow" model="activity" />
                    }
                </div>
            </section>
        }
    </div>

    <section class="panel">
        <div class="panel-heading"><div><h2>History</h2><p>From the audit log · latest first</p></div></div>
        @if (historyEntries.Count == 0)
        {
            <div class="empty-state">No recorded changes.</div>
        }
        <ul class="timeline">
            @foreach (var historyEntry in historyEntries)
            {
                <li>
                    <strong>@historyEntry.Action</strong>
                    <small>@historyEntry.CreatedAt.ToString("dd MMM yyyy, HH:mm") UTC · @historyEntry.Result</small>
                </li>
            }
        </ul>
    </section>
</div>
