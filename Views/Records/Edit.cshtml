@model RecordForm
@{
    var moduleName = Model.Module;
    var isNewRecord = Model.Id == Guid.Empty;
    var moduleTitle = CrmCatalog.ModuleTitle(moduleName);
    var singularName = moduleName switch
    {
        "customers" => "customer",
        "leads" => "lead",
        "opportunities" => "opportunity",
        "followups" => "follow-up",
        _ => "activity"
    };
    ViewData["Title"] = (isNewRecord ? "Add " : "Edit ") + singularName;
    var todayText = CrmCatalog.TodayInIndia.ToString("yyyy-MM-dd");
    string[] statusOptions = ViewBag.Statuses;
    // Leads move one step at a time, so the dropdown only offers the allowed next steps.
    var savedStatus = (string?)ViewBag.SavedStatus ?? Model.Status;
    if (moduleName == "leads")
        statusOptions = isNewRecord ? ["New"] : new[] { savedStatus }.Concat(CrmCatalog.NextLeadStatuses(savedStatus)).ToArray();
    var hasContactFields = moduleName is "customers" or "leads";
    var isDated = moduleName is "followups" or "activities";
}
<div class="page-heading">
    <div>
        <a class="back-link" href="/crm/@moduleName">@moduleTitle</a>
        <h1>@ViewData["Title"]</h1>
        <p class="muted">Fields marked * are required. Keep details current so the next conversation is easier.</p>
    </div>
</div>

<form method="post" action="/crm/@moduleName/save" class="panel record-form form-narrow" id="recordForm" data-module="@moduleName" data-record-owners="@System.Text.Json.JsonSerializer.Serialize((Dictionary<string, string>)ViewBag.RecordOwners)" novalidate>
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <input asp-for="Module" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="validation-panel" role="alert"></div>

    <h2>Basic details</h2>
    <div class="form-grid">
        <div class="full-width">
            <label asp-for="Name" class="form-label">@(isDated ? "Subject" : moduleName == "opportunities" ? "Opportunity name" : "Full name") *</label>
            <input asp-for="Name" class="form-control" maxlength="120" required />
            <span asp-validation-for="Name"></span>
        </div>
        <div>
            <label asp-for="Status" class="form-label">Status *</label>
            <select asp-for="Status" class="form-select">
                @foreach (var statusName in statusOptions)
                {
                    <option value="@statusName">@statusName</option>
                }
            </select>
            <span asp-validation-for="Status"></span>
            @if (moduleName == "leads")
            {
                <div class="form-text">New → Contacted → Qualified. Convert a qualified lead from its details page.</div>
            }
            @if (moduleName == "opportunities")
            {
                <div class="form-text">Set automatically from the stage.</div>
            }
        </div>
        <div>
            <label asp-for="OwnerId" class="form-label">Assigned to *</label>
            <select asp-for="OwnerId" class="form-select" asp-items="ViewBag.Owners"></select>
            <span asp-validation-for="OwnerId"></span>
        </div>

        @if (hasContactFields)
        {
            <div>
                <label asp-for="Email" class="form-label">Email *</label>
                <input asp-for="Email" class="form-control" type="email" maxlength="160" required placeholder="name@company.in" />
                <span asp-validation-for="Email"></span>
            </div>
            <div>
                <label asp-for="Phone" class="form-label">Mobile *</label>
                <input asp-for="Phone" class="form-control" required pattern="[6-9][0-9]{9}" maxlength="10" inputmode="numeric" placeholder="10-digit Indian mobile number" />
                <span asp-validation-for="Phone"></span>
            </div>
            <div>
                <label asp-for="Company" class="form-label">Company</label>
                <input asp-for="Company" class="form-control" maxlength="120" />
                <span asp-validation-for="Company"></span>
            </div>
        }

        @if (moduleName == "customers")
        {
            <div>
                <label asp-for="City" class="form-label">City</label>
                <input asp-for="City" class="form-control" maxlength="80" />
                <span asp-validation-for="City"></span>
            </div>
            <div class="full-width">
                <label asp-for="Address" class="form-label">Address</label>
                <input asp-for="Address" class="form-control" maxlength="300" />
                <span asp-validation-for="Address"></span>
            </div>
            <div>
                <label asp-for="State" class="form-label">State</label>
                <input asp-for="State" class="form-control" maxlength="80" />
                <span asp-validation-for="State"></span>
            </div>
        }

        @if (moduleName is "leads" or "opportunities")
        {
            <div>
                <label asp-for="Source" class="form-label">Source</label>
                <input asp-for="Source" class="form-control" maxlength="80" placeholder="Website, referral, exhibition…" />
                <span asp-validation-for="Source"></span>
            </div>
        }

        @if (moduleName == "leads")
        {
            <div>
                <label asp-for="Priority" class="form-label">Priority</label>
                <select asp-for="Priority" class="form-select">
                    @foreach (var priorityName in CrmCatalog.Priorities)
                    {
                        <option value="@priorityName">@priorityName</option>
                    }
                </select>
                <span asp-validation-for="Priority"></span>
            </div>
            <div>
                <label asp-for="ExpectedValue" class="form-label">Expected value (₹)</label>
                <input asp-for="ExpectedValue" class="form-control" type="number" min="0" max="999999999" step="0.01"
                       data-msg-min="Expected value must be between 0 and 99,99,99,999." data-msg-max="Expected value must be between 0 and 99,99,99,999." />
                <span asp-validation-for="ExpectedValue"></span>
                <div class="form-text">If above zero, an opportunity is created when the lead is converted.</div>
            </div>
        }
    </div>

    @if (moduleName is "opportunities" or "followups" or "activities")
    {
        <h2 style="margin-top:26px">@(moduleName == "opportunities" ? "Deal details" : "Schedule & link")</h2>
        <div class="form-grid">
            <div>
                <label asp-for="CustomerId" class="form-label">Related customer @(moduleName == "opportunities" ? "*" : "")</label>
                @if (moduleName == "opportunities")
                {
                    <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.Customers" required data-val="true" data-val-required="Select a customer."><option value="">Select customer</option></select>
                }
                else
                {
                    <select asp-for="CustomerId" class="form-select" asp-items="ViewBag.Customers"><option value="">Select customer</option></select>
                }
                <span asp-validation-for="CustomerId"></span>
            </div>
            <div>
                <label asp-for="LeadId" class="form-label">Related lead</label>
                <select asp-for="LeadId" class="form-select" asp-items="ViewBag.Leads"><option value="">Select lead</option></select>
                <span asp-validation-for="LeadId"></span>
            </div>

            @if (moduleName == "followups")
            {
                <div>
                    <label asp-for="OpportunityId" class="form-label">Related opportunity</label>
                    <select asp-for="OpportunityId" class="form-select" asp-items="ViewBag.Opportunities"><option value="">Select opportunity</option></select>
                    <span asp-validation-for="OpportunityId"></span>
                </div>
            }

            @if (moduleName == "opportunities")
            {
                <div>
                    <label asp-for="Stage" class="form-label">Stage *</label>
                    <select asp-for="Stage" class="form-select">
                        @foreach (var stageName in CrmCatalog.Stages)
                        {
                            <option value="@stageName">@stageName</option>
                        }
                    </select>
                    <span asp-validation-for="Stage"></span>
                </div>
                <div>
                    <label asp-for="Amount" class="form-label">Amount (₹) *</label>
                    <input asp-for="Amount" class="form-control" type="number" max="999999999" step="0.01" required
                           data-val-positive="Opportunity Amount must be greater than 0." data-msg-max="Opportunity Amount must be greater than 0 and at most 99,99,99,999." />
                    <span asp-validation-for="Amount"></span>
                </div>
                <div>
                    <label asp-for="Probability" class="form-label">Probability (%) *</label>
                    <input asp-for="Probability" class="form-control" type="number" min="0" max="100" step="1" required
                           data-msg-min="Probability must be between 0 and 100." data-msg-max="Probability must be between 0 and 100." />
                    <span asp-validation-for="Probability"></span>
                </div>
                <div>
                    <label asp-for="CloseDate" class="form-label">Expected close date *</label>
                    <input asp-for="CloseDate" class="form-control" type="date" required data-today="@todayText"
                           data-val="true" data-val-notpast="Expected Close Date cannot be in the past." data-msg-min="Expected Close Date cannot be in the past." />
                    <span asp-validation-for="CloseDate"></span>
                </div>
            }

            @if (isDated)
            {
                <div>
                    <label asp-for="Type" class="form-label">Type *</label>
                    <select asp-for="Type" class="form-select">
                        @foreach (var typeName in CrmCatalog.ActivityTypes)
                        {
                            <option value="@typeName">@typeName</option>
                        }
                    </select>
                    <span asp-validation-for="Type"></span>
                </div>
                <div>
                    <label asp-for="DueDate" class="form-label">@(moduleName == "followups" ? "Follow-up date" : "Activity date") *</label>
                    <input asp-for="DueDate" type="date" class="form-control" required data-is-new="@(isNewRecord ? "true" : "false")" data-today="@todayText"
                           data-val="true" data-val-notpast="Follow-up date cannot be earlier than today." data-msg-min="Follow-up date cannot be earlier than today." />
                    <span asp-validation-for="DueDate"></span>
                </div>
            }
        </div>
        @if (isDated)
        {
            <p class="form-text" style="margin-top:10px">Link exactly one customer, lead@(moduleName == "followups" ? " or opportunity" : ""). It must belong to the same assigned user.</p>
        }
    }

    <div class="form-grid" style="margin-top:16px">
        <div class="full-width">
            <label asp-for="Notes" class="form-label">@(moduleName == "activities" ? "Description" : "Notes / remarks")</label>
            <textarea asp-for="Notes" class="form-control" maxlength="2000" rows="4"></textarea>
            <span asp-validation-for="Notes"></span>
        </div>
    </div>

    <div class="form-actions">
        <a href="@(isNewRecord ? "/crm/" + moduleName : "/crm/" + moduleName + "/" + Model.Id)" class="btn btn-light">Cancel</a>
        <button class="btn btn-primary" type="submit">@(isNewRecord ? "Save " + singularName : "Save changes")</button>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/validation.js" asp-append-version="true"></script>
}
