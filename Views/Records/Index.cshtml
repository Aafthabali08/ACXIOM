@model PagedResult<RecordDto>
@{
    string moduleName = ViewBag.Module;
    RecordFilter filter = ViewBag.Filter;
    string[] statusOptions = ViewBag.Statuses;
    var moduleTitle = CrmCatalog.ModuleTitle(moduleName);
    var isSalesExecutive = User.IsInRole(CrmCatalog.SalesExecutiveRole);
    ViewData["Title"] = (isSalesExecutive ? "My " + moduleTitle.ToLowerInvariant() : moduleTitle);
    var isDated = moduleName is "followups" or "activities";
    if (moduleName == "followups")
        statusOptions = statusOptions.Append("Overdue").ToArray();
    var sortOptions = moduleName == "opportunities" ? new[] { "newest", "oldest", "name", "amount", "date" }
        : isDated ? new[] { "newest", "oldest", "name", "date" }
        : new[] { "newest", "oldest", "name" };
    var addButtonText = moduleName switch
    {
        "customers" => "+ Add customer",
        "leads" => "+ Add lead",
        "opportunities" => "+ Add opportunity",
        "followups" => "+ Schedule follow-up",
        _ => "+ Log activity"
    };
    var columnTwoTitle = moduleName == "opportunities" ? "Value & stage" : isDated ? "Date & type" : "Contact";
}
<div class="page-heading">
    <div>
        <div class="eyebrow">@(isSalesExecutive ? "My sales" : "Sales management")</div>
        <h1>@ViewData["Title"]</h1>
        <p class="muted">@Model.Total @(Model.Total == 1 ? "record" : "records") @(isSalesExecutive ? "assigned to you" : "across the team").</p>
    </div>
    <a class="btn btn-primary" href="/crm/@moduleName/create">@addButtonText</a>
</div>
<div asp-validation-summary="All" class="validation-panel" role="alert"></div>

<section class="panel">
    <form method="get" class="filter-bar" role="search">
        <div class="search-field">
            <label class="visually-hidden" for="searchBox">Search</label>
            <input id="searchBox" name="q" value="@filter.Search" class="form-control" placeholder="Search name, company, email, phone or owner" />
        </div>
        <select name="status" class="form-select" aria-label="Status">
            <option value="">All statuses</option>
            @foreach (var statusName in statusOptions)
            {
                <option value="@statusName" selected="@(filter.Status == statusName)">@statusName</option>
            }
        </select>
        @if (!isSalesExecutive)
        {
            <select name="owner" class="form-select" aria-label="Assigned user">
                <option value="">All owners</option>
                @foreach (var ownerOption in (SelectList)ViewBag.Owners)
                {
                    <option value="@ownerOption.Value" selected="@(filter.Owner == ownerOption.Value)">@ownerOption.Text</option>
                }
            </select>
        }
        @if (moduleName == "opportunities")
        {
            <select class="form-select" name="stage" aria-label="Stage">
                <option value="">All stages</option>
                @foreach (var stageName in CrmCatalog.Stages)
                {
                    <option selected="@(filter.Stage == stageName)">@stageName</option>
                }
            </select>
        }
        @if (isDated)
        {
            <select class="form-select" name="type" aria-label="Type">
                <option value="">All types</option>
                @foreach (var typeName in CrmCatalog.ActivityTypes)
                {
                    <option selected="@(filter.Type == typeName)">@typeName</option>
                }
            </select>
        }
        <input class="form-control" type="date" aria-label="From date" name="from" value="@filter.From?.ToString("yyyy-MM-dd")" />
        <input class="form-control" type="date" aria-label="To date" name="to" value="@filter.To?.ToString("yyyy-MM-dd")" />
        <select class="form-select" name="sort" aria-label="Sort by">
            @foreach (var sortName in sortOptions)
            {
                <option value="@sortName" selected="@(filter.Sort == sortName)">Sort: @sortName</option>
            }
        </select>
        <button class="btn btn-light" type="submit">Apply</button>
        <a href="/crm/@moduleName" class="clear-link">Clear</a>
    </form>

    <div class="table-wrap">
        <table class="table crm-table">
            <thead>
                <tr><th>@(isDated ? "Subject" : "Name")</th><th>@columnTwoTitle</th><th>Status</th><th>Assigned to</th><th>Created</th><th><span class="visually-hidden">Actions</span></th></tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Items)
                {
                    <tr>
                        <td>
                            <a class="record-name" href="/crm/@moduleName/@row.Id">@row.Name</a>
                            <small>@(moduleName is "customers" or "leads" ? $"{row.Code} · {row.Company}" : row.RelatedTo)</small>
                        </td>
                        <td>
                            @if (moduleName == "opportunities")
                            {
                                <strong>@DisplayHelpers.Rupees(row.Amount)</strong><small>@row.Stage · @row.Probability% · closes @row.CloseDate?.ToString("dd MMM yyyy")</small>
                            }
                            else if (isDated)
                            {
                                <span>@row.DueDate?.ToString("dd MMM yyyy")</span><small>@row.Type</small>
                            }
                            else
                            {
                                <span>@row.Email</span><small>@row.Phone</small>
                            }
                        </td>
                        <td>
                            <span class="status-badge @DisplayHelpers.StatusBadgeClass(row.Status)">@row.Status</span>
                            @if (row.IsOverdue)
                            {
                                <small class="text-danger">Overdue</small>
                            }
                        </td>
                        <td>@row.Owner</td>
                        <td>@row.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td>
                            <div class="row-actions">
                                @if ((moduleName == "followups" && row.Status == "Planned") || (moduleName == "activities" && row.Status == "Pending"))
                                {
                                    <form action="/crm/@moduleName/@row.Id/complete" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="returnUrl" value="@(Context.Request.Path + Context.Request.QueryString)" />
                                        <button class="done-button" type="submit" aria-label="Mark @row.Name as done">Mark done</button>
                                    </form>
                                }
                                @if (moduleName == "leads" && row.Status == "Converted")
                                {
                                    <a href="/crm/@moduleName/@row.Id">View</a>
                                }
                                else
                                {
                                    <a href="/crm/@moduleName/@row.Id/edit">Edit</a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Total == 0)
    {
        <div class="empty-state"><h3>No records found</h3><p>Try different filters, or <a href="/crm/@moduleName/create">add the first one</a>.</p></div>
    }
    <div class="pagination-bar">
        <span>@Model.Total records · Page @Model.Page of @Model.TotalPages</span>
        <div>
            @if (Model.HasPrevious)
            {
                <a class="btn btn-sm btn-light" data-page="@(Model.Page - 1)" href="?page=@(Model.Page - 1)">Previous</a>
            }
            @if (Model.HasNext)
            {
                <a class="btn btn-sm btn-light" data-page="@(Model.Page + 1)" href="?page=@(Model.Page + 1)">Next</a>
            }
        </div>
    </div>
</section>
