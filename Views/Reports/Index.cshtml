@model PagedResult<string[]>
@{
    string reportName = ViewBag.Report;
    RecordFilter filter = ViewBag.Filter;
    string[] headings = ViewBag.Headings;
    List<AppUser> ownerOptions = ViewBag.Owners;
    var isAdmin = User.IsInRole(CrmCatalog.AdminRole);
    var isSalesExecutive = User.IsInRole(CrmCatalog.SalesExecutiveRole);
    var isAuditStyle = reportName is "audit" or "user-activity";
    ViewData["Title"] = ReportService.ReportTitle(reportName) + " report";
    var statusOptions = reportName switch
    {
        "followups" => CrmCatalog.StatusesFor("followups").Append("Overdue").ToArray(),
        "customers" or "leads" or "opportunities" => CrmCatalog.StatusesFor(reportName),
        _ => Array.Empty<string>()
    };
}
<div class="page-heading">
    <div>
        <div class="eyebrow">@(reportName == "audit" ? "Security & compliance" : isSalesExecutive ? "My insights" : "Insights")</div>
        <h1>@ReportService.ReportTitle(reportName)</h1>
        <p class="muted">@(isAuditStyle ? "Who did what, and when. Times are in UTC." : isSalesExecutive ? "Numbers for the records assigned to you." : "Numbers behind the team's customer relationships.")</p>
    </div>
    <a class="btn btn-primary" data-export-link href="?report=@reportName&export=true">Export CSV</a>
</div>

<nav class="report-tabs" aria-label="Reports">
    @foreach (var tabName in ReportService.ReportNames.Where(name => ReportService.CanOpen(name, isAdmin, isSalesExecutive)))
    {
        <a href="/Reports?report=@tabName" class="@(tabName == reportName ? "active" : "")" aria-current="@(tabName == reportName ? "page" : null)">@ReportService.ReportTitle(tabName)</a>
    }
</nav>

<div asp-validation-summary="All" class="validation-panel" role="alert"></div>

<section class="panel">
    <form method="get" class="filter-bar" role="search">
        <input type="hidden" name="report" value="@reportName" />
        @if (reportName is not ("pipeline" or "conversion"))
        {
            <div class="search-field"><input class="form-control" name="q" value="@filter.Search" placeholder="Search this report" aria-label="Search report" /></div>
        }
        @if (!isSalesExecutive)
        {
            <select class="form-select" name="owner" aria-label="User">
                <option value="">All users</option>
                @foreach (var ownerOption in ownerOptions)
                {
                    <option value="@ownerOption.Id" selected="@(ownerOption.Id == filter.Owner)">@ownerOption.Name</option>
                }
            </select>
        }
        <input class="form-control" type="date" name="from" value="@filter.From?.ToString("yyyy-MM-dd")" aria-label="From date" />
        <input class="form-control" type="date" name="to" value="@filter.To?.ToString("yyyy-MM-dd")" aria-label="To date" />
        @if (reportName == "audit")
        {
            <select class="form-select" name="type" aria-label="Module">
                <option value="">All modules</option>
                @foreach (var moduleOption in CrmCatalog.Modules.Concat(new[] { "Users", "Authentication" }))
                {
                    <option value="@moduleOption" selected="@(filter.Type == moduleOption)">@moduleOption</option>
                }
            </select>
            <select class="form-select" name="status" aria-label="Action">
                <option value="">All actions</option>
                @foreach (var actionName in new[] { "Create", "Update", "Delete", "Status Change", "Reschedule", "Convert", "Login", "Failed Login", "Lockout", "Logout", "Register", "Role Change", "Password Reset", "Password Change", "Profile Update", "Unlock" })
                {
                    <option selected="@(filter.Status == actionName)">@actionName</option>
                }
            </select>
            <select name="result" class="form-select" aria-label="Result">
                <option value="">All results</option>
                @foreach (var resultName in new[] { "Success", "Failed" })
                {
                    <option selected="@(filter.Result == resultName)">@resultName</option>
                }
            </select>
        }
        else if (statusOptions.Length > 0)
        {
            <select class="form-select" name="status" aria-label="Status">
                <option value="">All statuses</option>
                @foreach (var statusName in statusOptions)
                {
                    <option selected="@(filter.Status == statusName)">@statusName</option>
                }
            </select>
        }
        <select name="sort" class="form-select" aria-label="Sort">
            <option value="newest" selected="@(filter.Sort == "newest")">Sort: newest</option>
            <option value="oldest" selected="@(filter.Sort == "oldest")">Sort: oldest</option>
            <option value="name" selected="@(filter.Sort == "name")">Sort: name</option>
        </select>
        <button class="btn btn-light" type="submit">Apply</button>
        <a class="clear-link" href="/Reports?report=@reportName">Clear</a>
    </form>

    <div class="table-wrap">
        <table class="table crm-table report-table">
            <thead><tr>@foreach (var heading in headings) {<th>@heading</th>}</tr></thead>
            <tbody>
                @foreach (var reportRow in Model.Items)
                {
                    <tr>@foreach (var cellValue in reportRow) {<td>@cellValue</td>}</tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Total == 0)
    {
        <div class="empty-state">No matching data for these filters.</div>
    }
    <div class="pagination-bar">
        <span>@Model.Total rows · Page @Model.Page of @Model.TotalPages</span>
        <div>
            @if (Model.HasPrevious)
            {
                <a class="btn btn-sm btn-light" data-page="@(Model.Page - 1)" href="?page=@(Model.Page - 1)">Previous</a>
            }
            @if (Model.HasNext)
            {
                <a class="btn btn-sm btn-light" data-page="@(Model.Page + 1)" href="?page=@(Model.Page + 1)">Next</a>
            }
        </div>
    </div>
</section>
