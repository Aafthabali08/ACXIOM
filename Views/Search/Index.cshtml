@model Dictionary<string, List<RecordDto>>
@{
    string searchText = ViewBag.Search;
    ViewData["Title"] = "Search";
    var totalMatches = Model.Values.Sum(results => results.Count);
}
<div class="page-heading">
    <div>
        <div class="eyebrow">Global search</div>
        <h1>@(searchText.Length >= 2 ? $"Results for “{searchText}”" : "Search everything")</h1>
        <p class="muted">Customers, leads, opportunities, follow-ups and activities you are allowed to see.</p>
    </div>
</div>

<section class="panel">
    <form method="get" action="/Search" class="filter-bar" role="search">
        <div class="search-field"><input class="form-control" name="q" value="@searchText" minlength="2" placeholder="Name, company, email, phone or code" aria-label="Search all modules" /></div>
        <button class="btn btn-primary" type="submit">Search</button>
    </form>
    @if (searchText.Length < 2)
    {
        <div class="empty-state">Type at least 2 characters.</div>
    }
    else if (totalMatches == 0)
    {
        <div class="empty-state"><h3>No matches</h3><p>Try a shorter word, a phone number or a customer code.</p></div>
    }
</section>

@foreach (var (moduleName, matches) in Model.Where(pair => pair.Value.Count > 0))
{
    <section class="panel" aria-label="@CrmCatalog.ModuleTitle(moduleName) results">
        <div class="panel-heading">
            <div><h2>@CrmCatalog.ModuleTitle(moduleName)</h2><p>@matches.Count match@(matches.Count == 1 ? "" : "es")</p></div>
            @if (matches.Count > 5)
            {
                <a href="/crm/@moduleName?q=@Uri.EscapeDataString(searchText)">See all @matches.Count</a>
            }
        </div>
        <div class="task-list">
            @foreach (var match in matches.Take(5))
            {
                <div class="task-row">
                    <div class="task-text">
                        <a href="/crm/@moduleName/@match.Id">@match.Name</a>
                        <small>@string.Join(" · ", new[] { match.Code, match.Company, match.Email, match.Phone, match.RelatedTo, match.Owner }.Where(part => !string.IsNullOrWhiteSpace(part)))</small>
                    </div>
                    <div class="task-side"><span class="status-badge @(match.IsOverdue ? "negative" : DisplayHelpers.StatusBadgeClass(match.Status))">@(match.IsOverdue ? "Overdue" : match.Status)</span></div>
                </div>
            }
        </div>
    </section>
}
