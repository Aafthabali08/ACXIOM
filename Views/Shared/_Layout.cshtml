@inject Microsoft.AspNetCore.Identity.UserManager<AppUser> UserManager
@inject CrmService CrmService
@{
    var isSignedIn = User.Identity?.IsAuthenticated == true;
    var currentUser = isSignedIn ? await UserManager.GetUserAsync(User) : null;
    var roleName = User.IsInRole(CrmCatalog.AdminRole) ? CrmCatalog.AdminRole
        : User.IsInRole(CrmCatalog.ManagerRole) ? CrmCatalog.ManagerRole
        : User.IsInRole(CrmCatalog.SalesExecutiveRole) ? CrmCatalog.SalesExecutiveRole : "";
    var hasCrmRole = isSignedIn && currentUser != null && roleName != "";
    var roleTitle = CrmCatalog.RoleTitle(roleName);
    var currentMatchKey = NavigationMenu.CurrentMatchKey(Context.Request.Path.ToString(), Context.Request.Query["report"].ToString());
    var dueFollowUpCount = hasCrmRole ? await CrmService.CountDueFollowUpsAsync() : 0;
    var userInitials = DisplayHelpers.Initials(currentUser?.Name);
}
<!DOCTYPE html>
<html lang="en-IN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · AcxiomCRM</title>
    <meta name="description" content="AcxiomCRM – customer, lead, opportunity and follow-up management for sales teams" />
    <link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(hasCrmRole ? "app-body" : "auth-body")">
    <partial name="_Icons" />
    <a class="skip-link" href="#main">Skip to content</a>
    @if (hasCrmRole)
    {
        <button class="sidebar-scrim" type="button" aria-label="Close navigation" tabindex="-1" hidden></button>
        <div class="app-shell">
            <aside class="sidebar" id="sidebar">
                <a class="brand" href="/"><span class="brand-mark">a</span><span>acxiom<span class="brand-crm">CRM</span></span></a>
                <div class="workspace-chip"><small>Workspace</small><strong>@roleTitle</strong></div>
                <nav class="side-nav" aria-label="Main navigation">
                    @foreach (var menuSection in NavigationMenu.ForRole(roleName))
                    {
                        <div class="nav-section-title">@menuSection.Title</div>
                        @foreach (var menuLink in menuSection.Links)
                        {
                            var isSelected = menuLink.MatchKey == currentMatchKey;
                            <a href="@menuLink.Url" class="@(isSelected ? "selected" : "")" aria-current="@(isSelected ? "page" : null)">
                                <svg aria-hidden="true"><use href="#i-@menuLink.Icon" /></svg>@menuLink.Label
                            </a>
                        }
                    }
                </nav>
                <div class="sidebar-user">
                    <div class="avatar" aria-hidden="true">@userInitials</div>
                    <div><strong>@currentUser!.Name</strong><small>@currentUser.Email</small></div>
                </div>
            </aside>

            <div class="app-main">
                <header class="topbar">
                    <button class="icon-button menu-button" type="button" aria-label="Open navigation" aria-controls="sidebar" aria-expanded="false"><svg aria-hidden="true"><use href="#i-menu" /></svg></button>
                    <div class="topbar-title">AcxiomCRM / <strong>@ViewData["Title"]</strong></div>
                    <form class="topbar-search" method="get" action="/Search" role="search">
                        <label class="visually-hidden" for="globalSearch">Search all records</label>
                        <input id="globalSearch" class="form-control" type="search" name="q" minlength="2" placeholder="Search records…" />
                    </form>
                    <div class="topbar-actions">
                        <a class="icon-button" href="/crm/followups?status=Planned&sort=date" title="Follow-ups due today or overdue" aria-label="@dueFollowUpCount follow-ups due">
                            <svg aria-hidden="true"><use href="#i-bell" /></svg>
                            @if (dueFollowUpCount > 0)
                            {
                                <span class="count-badge">@(dueFollowUpCount > 99 ? "99+" : dueFollowUpCount.ToString())</span>
                            }
                        </a>
                        <button class="icon-button" type="button" data-theme-toggle aria-label="Switch between light and dark theme" title="Switch theme">
                            <svg class="theme-icon-light" aria-hidden="true"><use href="#i-moon" /></svg>
                            <svg class="theme-icon-dark" aria-hidden="true"><use href="#i-sun" /></svg>
                        </button>
                        <span class="role-chip header-role">@roleTitle</span>
                        <a class="avatar" href="/Account/Profile" title="My profile" aria-label="My profile">@userInitials</a>
                        <form action="/Account/Logout" method="post">
                            @Html.AntiForgeryToken()
                            <button class="logout-button" type="submit">Log out</button>
                        </form>
                    </div>
                </header>
                <main id="main" class="main-content">
                    <partial name="_Alerts" />
                    @RenderBody()
                </main>
                <footer class="app-footer">
                    <span>AcxiomCRM · @roleTitle workspace</span>
                    <span>Dates follow India time · Amounts in ₹</span>
                </footer>
            </div>
        </div>
    }
    else
    {
        <button class="icon-button auth-theme-toggle" type="button" data-theme-toggle aria-label="Switch between light and dark theme" title="Switch theme">
            <svg class="theme-icon-light" aria-hidden="true"><use href="#i-moon" /></svg>
            <svg class="theme-icon-dark" aria-hidden="true"><use href="#i-sun" /></svg>
        </button>
        <main id="main" class="auth-main">
            @RenderBody()
        </main>
    }
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
