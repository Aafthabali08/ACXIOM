@model DashboardFilter
@* Today / This week / This month / custom range buttons used by the dashboard and the team page. *@
@{
    var fromValue = Model.From?.ToString("yyyy-MM-dd");
    var toValue = Model.To?.ToString("yyyy-MM-dd");
    var periodOptions = new[] { ("all", "All time"), ("today", "Today"), ("week", "This week"), ("month", "This month") };
}
<form method="get" class="date-bar" aria-label="Choose period">
    <div class="period-options">
        @foreach (var (periodValue, periodText) in periodOptions)
        {
            <button name="period" value="@periodValue" class="period-button @(Model.Period == periodValue ? "active" : "")" aria-pressed="@(Model.Period == periodValue ? "true" : "false")">@periodText</button>
        }
    </div>
    <div class="date-inputs">
        <label>From <input class="form-control" type="date" name="from" value="@fromValue" aria-label="From date" /></label>
        <label>To <input class="form-control" type="date" name="to" value="@toValue" aria-label="To date" /></label>
        <button class="btn btn-light btn-sm @(Model.Period == "custom" ? "active" : "")" name="period" value="custom">Apply range</button>
    </div>
</form>
