@model RecordDto
@* One follow-up or activity line with an optional "Mark done" button. *@
@{
    var canMarkDone = (Model.Module == "followups" && Model.Status == "Planned") || (Model.Module == "activities" && Model.Status == "Pending");
    var currentPage = Context.Request.Path + Context.Request.QueryString;
    var dueText = Model.Module == "followups" && Model.Status == "Planned" ? DisplayHelpers.DueLabel(Model.DueDate) : Model.DueDate?.ToString("dd MMM");
}
<div class="task-row">
    <span class="task-icon" aria-hidden="true"><svg><use href="#@DisplayHelpers.TypeIcon(Model.Type)" /></svg></span>
    <div class="task-text">
        <a href="/crm/@Model.Module/@Model.Id">@Model.Name</a>
        <small>@Model.Type · @(Model.RelatedTo ?? "No related record") · @Model.Owner</small>
    </div>
    <div class="task-side">
        <span class="status-badge @(Model.IsOverdue ? "negative" : DisplayHelpers.StatusBadgeClass(Model.Status))">@(Model.Status == "Planned" ? dueText : Model.Status)</span>
        @if (canMarkDone)
        {
            <form action="/crm/@Model.Module/@Model.Id/complete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@currentPage" />
                <button class="done-button" type="submit" aria-label="Mark @Model.Name as done">Mark done</button>
            </form>
        }
    </div>
</div>
