@model TeamPageViewModel
@{
    ViewData["Title"] = "Team performance";
    var filter = Model.Filter;
    var periodQuery = $"from={filter.From:yyyy-MM-dd}&to={filter.To:yyyy-MM-dd}";
    var members = Model.Members;
}
<div class="page-heading">
    <div>
        <div class="eyebrow">Team management · @filter.PeriodLabel</div>
        <h1>Team performance</h1>
        <p class="muted">Leads, deals and follow-up discipline for each sales executive.</p>
    </div>
    <div class="page-actions">
        <a class="btn btn-light" href="/Reports?report=user-activity">Team activity log</a>
        <a class="btn btn-primary" href="/Reports?report=pipeline&@periodQuery">Pipeline report</a>
    </div>
</div>

<div asp-validation-summary="All" class="validation-panel" role="alert"></div>
<partial name="_PeriodFilter" model="filter" />
<p class="scope-note">Leads, deals and activities created in the selected period. Overdue follow-ups are counted as of today.</p>

<section class="metric-grid" aria-label="Team totals">
    <div class="metric">
        <div class="metric-label">Team members <svg aria-hidden="true"><use href="#i-team" /></svg></div>
        <strong>@members.Count</strong><small>@members.Sum(member => member.ActivitiesLogged) activities logged</small>
    </div>
    <div class="metric">
        <div class="metric-label">Leads handled <svg aria-hidden="true"><use href="#i-target" /></svg></div>
        <strong>@members.Sum(member => member.LeadCount)</strong><small>@members.Sum(member => member.ConvertedLeads) converted to customers</small>
    </div>
    <div class="metric">
        <div class="metric-label">Deals won <svg aria-hidden="true"><use href="#i-rupee" /></svg></div>
        <strong>@DisplayHelpers.Rupees(members.Sum(member => member.WonValue))</strong><small>@members.Sum(member => member.WonDeals) won · @members.Sum(member => member.LostDeals) lost</small>
    </div>
    <div class="metric inverted">
        <div class="metric-label">Open pipeline <svg aria-hidden="true"><use href="#i-chart" /></svg></div>
        <strong>@DisplayHelpers.Rupees(members.Sum(member => member.OpenPipeline))</strong><small>@DisplayHelpers.Rupees(members.Sum(member => member.WeightedPipeline)) weighted</small>
    </div>
</section>

<section class="panel" style="margin-top:16px" aria-labelledby="memberTableHeading">
    <div class="panel-heading"><div><h2 id="memberTableHeading">By team member</h2><p>Select a name to open their leads, or a number to see the matching records</p></div></div>
    <div class="table-wrap">
        <table class="table crm-table">
            <thead>
                <tr>
                    <th>Team member</th><th class="number-cell">Leads</th><th class="number-cell">Converted</th><th class="number-cell">Open deals</th>
                    <th class="number-cell">Open pipeline</th><th class="number-cell">Weighted</th><th class="number-cell">Won</th><th class="number-cell">Won value</th>
                    <th class="number-cell">Win rate</th><th class="number-cell">Activities</th><th class="number-cell">Overdue</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var member in members)
                {
                    <tr>
                        <td><a class="record-name" href="/crm/leads?owner=@member.UserId&@periodQuery">@member.Name</a></td>
                        <td class="number-cell">@member.LeadCount</td>
                        <td class="number-cell">@member.ConvertedLeads</td>
                        <td class="number-cell"><a href="/crm/opportunities?owner=@member.UserId&status=Open&@periodQuery">@member.OpenDeals</a></td>
                        <td class="number-cell">@DisplayHelpers.Rupees(member.OpenPipeline)</td>
                        <td class="number-cell">@DisplayHelpers.Rupees(member.WeightedPipeline)</td>
                        <td class="number-cell"><a href="/crm/opportunities?owner=@member.UserId&status=Won&@periodQuery">@member.WonDeals</a></td>
                        <td class="number-cell">@DisplayHelpers.Rupees(member.WonValue)</td>
                        <td class="number-cell">@member.WinRate</td>
                        <td class="number-cell"><a href="/crm/activities?owner=@member.UserId&@periodQuery">@member.ActivitiesLogged</a></td>
                        <td class="number-cell">@if (member.OverdueFollowUps > 0) {<a class="text-danger" href="/crm/followups?owner=@member.UserId&status=Overdue">@member.OverdueFollowUps</a>} else {<span>0</span>}</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (members.Count == 0)
    {
        <div class="empty-state"><h3>No team members yet</h3><p>Sales executives appear here once they are added.</p></div>
    }
</section>
