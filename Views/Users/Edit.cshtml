@model UserForm
@{
    var isNewUser = string.IsNullOrEmpty(Model.Id);
    ViewData["Title"] = isNewUser ? "Add user" : "Edit user";
}
<div class="page-heading">
    <div>
        <a class="back-link" href="/Users">Users &amp; access</a>
        <h1>@ViewData["Title"]</h1>
        <p class="muted">@(isNewUser ? "Create an account and give it exactly one role." : "Changing the role, status or password signs this user out of their current sessions.")</p>
    </div>
</div>
<form method="post" action="/Users/Edit" class="panel record-form form-narrow">
    @Html.AntiForgeryToken()
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="validation-panel" role="alert"></div>
    <div class="form-grid">
        <div>
            <label asp-for="Name" class="form-label">Full name *</label>
            <input asp-for="Name" class="form-control" maxlength="80" />
            <span asp-validation-for="Name"></span>
        </div>
        <div>
            <label asp-for="Email" class="form-label">Email *</label>
            <input asp-for="Email" class="form-control" type="email" maxlength="160" autocomplete="off" />
            <span asp-validation-for="Email"></span>
        </div>
        <div>
            <label asp-for="Role" class="form-label">Role *</label>
            <select asp-for="Role" class="form-select">
                @foreach (var roleName in CrmCatalog.Roles)
                {
                    <option value="@roleName">@CrmCatalog.RoleTitle(roleName)</option>
                }
            </select>
            <span asp-validation-for="Role"></span>
        </div>
        <div>
            <label asp-for="Password" class="form-label">@(isNewUser ? "Password *" : "Reset password (optional)")</label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="Password"></span>
            <div class="form-text">At least 8 characters with uppercase, lowercase, a number and a symbol.</div>
        </div>
        <div class="full-width">
            <div class="form-check">
                <input asp-for="Active" class="form-check-input" />
                <label asp-for="Active" class="form-check-label">Active account (can sign in)</label>
            </div>
        </div>
    </div>
    <div class="form-actions">
        <a class="btn btn-light" href="/Users">Cancel</a>
        <button class="btn btn-primary" type="submit">@(isNewUser ? "Create user" : "Save changes")</button>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
