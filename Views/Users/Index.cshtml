@model PagedResult<AppUser>
@{
    ViewData["Title"] = "Users & access";
    Dictionary<string, string> roleByUserId = ViewBag.Roles;
    string? selectedRole = ViewBag.Role;
    string? selectedState = ViewBag.State;
    string? currentUserId = ViewBag.CurrentUserId;
    string selectedSort = ViewBag.Sort;
}
<div class="page-heading">
    <div>
        <div class="eyebrow">User administration</div>
        <h1>Users &amp; access</h1>
        <p class="muted">Add team members, change roles, reset passwords and unlock accounts.</p>
    </div>
    <div class="page-actions">
        <a href="/Users/Roles" class="btn btn-light">Roles &amp; permissions</a>
        <a href="/Users/Edit" class="btn btn-primary">+ Add user</a>
    </div>
</div>

<section class="panel">
    <form class="filter-bar" method="get" role="search">
        <div class="search-field"><input class="form-control" name="q" value="@ViewBag.Search" placeholder="Search name or email" aria-label="Search users" /></div>
        <select class="form-select" name="role" aria-label="Role">
            <option value="">All roles</option>
            @foreach (var roleName in CrmCatalog.Roles)
            {
                <option value="@roleName" selected="@(roleName == selectedRole)">@CrmCatalog.RoleTitle(roleName)</option>
            }
        </select>
        <select class="form-select" name="state" aria-label="Account state">
            <option value="">All accounts</option>
            <option value="active" selected="@(selectedState == "active")">Active</option>
            <option value="inactive" selected="@(selectedState == "inactive")">Inactive</option>
            <option value="locked" selected="@(selectedState == "locked")">Locked</option>
        </select>
        <select class="form-select" name="sort" aria-label="Sort users">
            @foreach (var (sortValue, sortText) in new[] { ("name", "Sort: name"), ("email", "Sort: email"), ("newest", "Sort: newest"), ("oldest", "Sort: oldest") })
            {
                <option value="@sortValue" selected="@(selectedSort == sortValue)">@sortText</option>
            }
        </select>
        <button class="btn btn-light" type="submit">Apply</button>
        <a class="clear-link" href="/Users">Clear</a>
    </form>

    <div class="table-wrap">
        <table class="table crm-table">
            <thead><tr><th>User</th><th>Role</th><th>Status</th><th>Sign-in</th><th>Joined</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
            <tbody>
                @foreach (var user in Model.Items)
                {
                    var isLocked = user.LockoutEnd > DateTimeOffset.UtcNow;
                    <tr>
                        <td><strong>@user.Name</strong>@if (user.Id == currentUserId) {<span class="faint"> (you)</span>}<small>@user.Email</small></td>
                        <td>@CrmCatalog.RoleTitle(roleByUserId.GetValueOrDefault(user.Id, ""))</td>
                        <td><span class="status-badge @(user.Active ? "positive" : "negative")">@(user.Active ? "Active" : "Inactive")</span></td>
                        <td>@if (isLocked) {<span class="status-badge negative">Locked until @user.LockoutEnd!.Value.UtcDateTime.ToString("dd MMM, HH:mm") UTC</span>} else {<span class="muted">Normal</span>}</td>
                        <td>@user.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td>
                            <div class="row-actions">
                                @if (isLocked)
                                {
                                    <form action="/Users/Unlock" method="post">
                                        @Html.AntiForgeryToken()
                                        <input name="id" value="@user.Id" type="hidden" />
                                        <button class="done-button" type="submit">Unlock</button>
                                    </form>
                                }
                                <a href="/Users/Edit/@user.Id">Edit</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.Total == 0)
    {
        <div class="empty-state">No users match these filters.</div>
    }
    <div class="pagination-bar">
        <span>@Model.Total users · Page @Model.Page of @Model.TotalPages</span>
        <div>
            @if (Model.HasPrevious)
            {
                <a class="btn btn-sm btn-light" data-page="@(Model.Page - 1)" href="?page=@(Model.Page - 1)">Previous</a>
            }
            @if (Model.HasNext)
            {
                <a class="btn btn-sm btn-light" data-page="@(Model.Page + 1)" href="?page=@(Model.Page + 1)">Next</a>
            }
        </div>
    </div>
</section>
