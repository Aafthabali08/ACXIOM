@model Dictionary<string, int>
@{
    ViewData["Title"] = "Roles & permissions";
    // This table describes the rules already enforced by [Authorize] attributes and CrmService ownership checks.
    var permissionRows = new[]
    {
        ("Dashboard", "Company dashboard, system access, audit feed", "Team dashboard, team performance", "Personal dashboard, today's agenda"),
        ("Customers, leads, opportunities", "All records", "All team records", "Only records assigned to them"),
        ("Follow-ups and activities", "All records", "All team records", "Only records assigned to them"),
        ("Assign records to", "Any active user", "Any active user", "Only themselves"),
        ("Lead conversion", "Yes", "Yes", "Own qualified leads"),
        ("Sales reports and CSV export", "All records", "All team records", "Own records"),
        ("Team performance page", "Yes", "Yes", "No"),
        ("User activity report", "Yes (incl. security events)", "Yes (CRM changes only)", "No"),
        ("Users, roles, password reset, unlock", "Yes", "No", "No"),
        ("Full audit log", "Yes", "No", "No"),
        ("My profile and password change", "Yes", "Yes", "Yes")
    };
}
<div class="page-heading">
    <div>
        <a class="back-link" href="/Users">Users &amp; access</a>
        <h1>Roles &amp; permissions</h1>
        <p class="muted">Every account has exactly one role. New self-registered accounts start as Sales Executive.</p>
    </div>
    <a class="btn btn-primary" href="/Users/Edit">+ Add user</a>
</div>

<section class="metric-grid" style="grid-template-columns:repeat(3,minmax(0,1fr))" aria-label="Users per role">
    @foreach (var roleName in CrmCatalog.Roles)
    {
        <a class="metric" href="/Users?role=@roleName">
            <div class="metric-label">@CrmCatalog.RoleTitle(roleName) <svg aria-hidden="true"><use href="#i-shield" /></svg></div>
            <strong>@Model.GetValueOrDefault(roleName)</strong><small>View these users</small>
        </a>
    }
</section>

<section class="panel" style="margin-top:16px">
    <div class="table-wrap">
        <table class="table crm-table">
            <thead><tr><th>Capability</th><th>Administrator</th><th>Sales Manager</th><th>Sales Executive</th></tr></thead>
            <tbody>
                @foreach (var (capability, adminAccess, managerAccess, salesAccess) in permissionRows)
                {
                    <tr>
                        <td><strong>@capability</strong></td>
                        <td class="@(adminAccess == "No" ? "permission-no" : "permission-yes")">@adminAccess</td>
                        <td class="@(managerAccess == "No" ? "permission-no" : "permission-yes")">@managerAccess</td>
                        <td class="@(salesAccess == "No" ? "permission-no" : "permission-yes")">@salesAccess</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
